# Environment variables — real secrets live only in the root .env (gitignored);
# .env.example files document the shape and are meant to be committed.
.env
.env.*
!.env.example

.DS_Store

# Database dumps from scripts/backup_restore_drill.py. These contain real user
# data — never commit them, and store them off the cluster they back up.
backups/
backend_api/backups/
*.bson

# Generated synthetic training data. Deterministic under --seed, so regenerate
# rather than commit: python3 scripts/generate_synthetic_users.py
backend_api/data/
